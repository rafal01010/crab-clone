{
  "name": "you-can-crab-everything",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.3 <25",
    "npm": ">=11.19.1 <12"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && tsc -p tsconfig.host.json",
    "start": "node build-host/server/index.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --project tsconfig.server.json",
    "test": "node --test",
    "prepare": "svelte-kit sync",
    "checkpoint:foundation": "node scripts/checkpoint-01.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "@sveltejs/adapter-node": "6.0.2",
    "@sveltejs/kit": "3.2.0",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "svelte": "5.57.3",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.2",
    "@types/three": "0.187.0",
    "eslint": "10.15.0",
    "eslint-plugin-svelte": "3.24.1",
    "globals": "17.14.0",
    "playwright-core": "1.65.1",
    "prettier": "3.10.1",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8"
  },
  "imports": {
    "#lib/*": "./src/lib/*",
    "#shared/*": "./shared/*"
  }
}
